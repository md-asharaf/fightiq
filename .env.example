# ──────────────────────────────────────────────
# FightIQ Environment Variables — Example File
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Google / Gemini API ──────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=fightiq
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=fightiq
# Used by the backend service (inside Docker network use service name 'db')
DATABASE_URL=postgresql+asyncpg://fightiq:change_me_in_production@db:5432/fightiq

# ── Backend Settings ─────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Embeddings / LLM ─────────────────────────
EMBEDDING_MODEL=models/text-embedding-004
LLM_MODEL=gemini-2.0-flash
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=120
